# Superuser (used by the image itself)
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres

# Format: db[:user[:pass]],db[:user[:pass]],...
#
#   appdb                    -> owned by POSTGRES_USER, no new role
#   shared:admin             -> same, explicit superuser as owner
#   authdb:auth_user:s3cret  -> creates role auth_user, owns authdb
#   billing:bill_user:a:b:c  -> password is "a:b:c" (colons are fine)
#   reports:auth_user:s3cret -> reuses an existing role; the password is
#                               still required but ignored if the role exists
#
# Not allowed:
#   authdb:auth_user         -> error, new roles need a password
#   :user:pass               -> error, empty database name
#   commas in passwords      -> they split entries
#
# Passwords containing $ or # (compose interpolates $ and treats " #" as a
# comment) need the whole value in single quotes.
POSTGRES_MULTIPLE_DATABASES=appdb,shared:admin,authdb:auth_user:s3cret,billing:bill_user:a:b:c,reports:auth_user:s3cret
